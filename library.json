{
  "name": "SensorCurrent",
  "version": "4.1.0",
  "description": "Mesure du courant alternatif (AC) avec les capteurs ACS712, SCT-013 et similaires : intensité crête, RMS, puissance apparente, filtrage et calibration.",
  "keywords": [
    "acs712",
    "sct013",
    "capteur",
    "current sensor",
    "courant alternatif",
    "ac current",
    "rms",
    "arduino",
    "mesure courant",
    "capteur intensite",
    "puissance apparente"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/boby15000/SensorCurrent.git"
  },
  "authors": [
    {
      "name": "Nicolas Fourgheon",
      "email": "boby15000@hotmail.com",
      "maintainer": true
    }
  ],
  "examples": [
    {
      "name": "Mesure Courant SCT-013",
      "base": "examples/mesureCurrent/",
      "files": ["mesureCurrent.cpp"]
    },
    {
      "name": "Mesure Courant ACS712",
      "base": "examples/mesureCourantACS712/",
      "files": ["mesureCourantACS712.cpp"]
    }
  ],
  "license": "MIT",
  "frameworks": ["arduino"],
  "platforms": ["atmelavr", "espressif8266", "espressif32"],
  "export": {
    "exclude": [
      "src/main.cpp",
      ".*",
      "/.*",
      "platformio.ini",
      "/test",
      "/include",
      "/lib"
    ]
  },
  "homepage": "https://github.com/boby15000/SensorCurrent",
  "issues": "https://github.com/boby15000/SensorCurrent/issues"
}